# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @public @dynamic @type=url
CORS_ORIGIN=

# OTP delivery is disabled by default. dev-console prints the short-lived code
# to server logs and is rejected when NODE_ENV=production.
# @required=false @type=enum(disabled, dev-console, whatsapp)
OTP_PROVIDER=disabled

# Shared with Commerce for short-lived, server-to-server customer assertions.
# @required=false @type=string(minLength=32)
VENDURE_IDENTITY_SECRET=

# @required=false @type=url
VENDURE_SHOP_API_URL=

# @required=false @type=string(minLength=1)
VENDURE_CHANNEL_TOKEN=

# Meta WhatsApp Cloud API is used only when OTP_PROVIDER=whatsapp.
# @required=false @type=string(minLength=1)
WHATSAPP_ACCESS_TOKEN=

# @required=false @type=string(minLength=1)
WHATSAPP_PHONE_NUMBER_ID=

# @required=false @type=string(minLength=1)
WHATSAPP_OTP_TEMPLATE_NAME=

# @required=false @type=string(minLength=1)
WHATSAPP_OTP_TEMPLATE_LANGUAGE=
# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=

# @type=string(minLength=1)
DATABASE_URL=
